# =============================================================================
# BANCO DE DADOS — PostgreSQL
# =============================================================================

# Usuário que a aplicação vai usar para se conectar
POSTGRES_USER=softcalls

# Senha do usuário acima — troque em produção por algo forte
POSTGRES_PASSWORD=troque_essa_senha

# Nome do banco de dados que será criado automaticamente na primeira vez
POSTGRES_DB=chamados

# Porta exposta no seu host (a sua máquina). O container sempre usa 5432
# internamente — essa porta é só para você acessar de fora (ex: DBeaver, pgAdmin)
POSTGRES_PORT=5432

# =============================================================================
# PGADMIN — Interface visual para explorar o banco (só para desenvolvimento)
# =============================================================================

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080
